; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Popo"
config/version="0.13.1"
config/description="Isometric co-op police game. Wave 0 prototypes."
run/main_scene="res://game/ui/main_menu.tscn"
config/project_settings_override="user://override.cfg"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Controls="*res://game/core/controls.gd"
Net="*res://game/net/net.gd"
Pings="*res://game/core/pings.gd"
Settings="*res://game/core/settings.gd"
Perf="*res://game/core/perf.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="vehicles"
3d_physics/layer_4="debris"
3d_physics/layer_5="chunks"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
jolt_physics_3d/limits/max_bodies=131072
jolt_physics_3d/limits/max_body_pairs=131072
jolt_physics_3d/limits/max_contact_constraints=40960
jolt_physics_3d/limits/temporary_memory_buffer_size=160

[rendering]

limits/global_shader_variables/buffer_size=1048576

anti_aliasing/quality/msaa_3d=2
occlusion_culling/use_occlusion_culling=true

[navigation]

3d/default_cell_height=0.1
